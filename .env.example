# ─────────────────────────────────────────────────────────────────────────────
# Service URLs and API keys
# See experiment_config.py for experiment settings (model / judge / benchmark / task_ids / search engine).
# ─────────────────────────────────────────────────────────────────────────────

# LLM service URL and API key for the main model (WebSwarm agent / page summary).
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
LLM_API_KEY=xxxxx

# Service URL and API key for the benchmark judge model (configured in experiment_config.py).
JUDGE_MODEL_BASE_URL=https://api.novita.ai/anthropic
JUDGE_MODEL_API_KEY=xxxxx

# Web search: service URLs and API keys for Serper (search) and Jina (web page retrieval).
SERPER_BASE_URL=https://google.serper.dev/search
SERPER_API_KEY=xxxxx
JINA_BASE_URL=https://r.jina.ai
JINA_API_KEY=xxxxx

# Local search: root URL of the self-hosted retrieval service (used only when SEARCH_ENGINE="local" in experiment_config.py).
LOCAL_ENGINE_BASE_URL=http://localhost:8080
